---
// «¿Lo habéis visto?»: la entrada ligera al glosario (diseño, sección 5). Primero la escena y, al
// girarla, lo que puede haber detrás. Sin JavaScript es una lista con cada reverso en un <details>;
// con JavaScript se ve una tarjeta cada vez y se pueden marcar las escenas que os suenan.
// De vez en cuando, una escena de elegir («¿Crisis o rabieta?»), que no se marca.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import EscenaElegir from '../components/EscenaElegir.astro';
import NombreTermino from '../components/NombreTermino.astro';
import Base from '../layouts/Base.astro';
import { ordenarTarjetas, primeraFrase } from '../lib/tarjetas';
import { tituloEnIngles } from '../lib/terminos';
import { FAMILIAS } from '../lib/tokens';

const glosario = await getCollection('glosario');
const porId = new Map(glosario.map((t) => [t.id, t]));
const tarjetas = ordenarTarjetas(glosario, await getCollection('escenarios'));
// Los términos de las escenas, sin repetir y en el orden en que salen: es el orden de «Lo que habéis reconocido».
const terminos = [...new Map(tarjetas.flatMap((t) => (t.tipo === 'escena' ? [[t.termino.id, t.termino] as const] : []))).values()];
const nombreFamilia = (id: string) => FAMILIAS.find((f) => f.id === id)!.nombre;
// Una escena de elegir lleva el color de su primer término.
const terminosDe = (ids: { id: string }[]) => ids.map((r) => porId.get(r.id)!);
---

<Base titulo="¿Lo habéis visto?" descripcion="Escenas del día a día de niñas y niños, y lo que puede haber detrás de cada una. Una escena sola no dice nada: cuenta el conjunto.">
  <div class="escenas-pagina">
    <header class="intro">
      <h1>¿Lo habéis visto?</h1>
      <p class="entradilla">Escenas del día a día de niñas y niños, inventadas pero posibles. Primero, la escena. Después, si queréis, lo que puede haber detrás.</p>
      <p class="aviso">Una escena sola no dice nada. Lo que cuenta es el conjunto, que se mantenga en el tiempo y que le afecte en su día a día. Y quien puede valorarlo es un profesional.</p>
    </header>

    <div class="visor" data-visor>
      <p class="progreso" aria-live="polite" data-progreso hidden></p>
      <ol class="tarjetas">
        {tarjetas.map((tarjeta, i) => tarjeta.tipo === 'elegir' ? (
          <li class={`tarjeta f-${terminosDe(tarjeta.escenario.data.terminos)[0].data.familia}`} id={`escena-${tarjeta.id}`} data-tarjeta data-id={tarjeta.id}>
            <EscenaElegir escenario={tarjeta.escenario} nivel={2} />
            {terminosDe(tarjeta.escenario.data.terminos).map((termino) => (
              <p>
                <a href={`/glosario/${termino.id}/`}>Leer la ficha<span class="visualmente-oculto"> de <span lang={tituloEnIngles(termino.data) ? 'en' : undefined}>{termino.data.termino}</span></span></a>
              </p>
            ))}
          </li>
        ) : (
          <li class={`tarjeta f-${tarjeta.termino.data.familia}`} id={`escena-${tarjeta.id}`} data-tarjeta data-id={tarjeta.id} data-termino={tarjeta.termino.id}>
            {tarjeta.escena.imagen && (
              // El alt va vacío a propósito: la imagen no cuenta nada que no diga el texto (guía de escenas).
              <Image src={tarjeta.escena.imagen} alt="" widths={[400, 800, 1200]} sizes="(min-width: 48rem) 40rem, 100vw" loading={i === 0 ? 'eager' : 'lazy'} class="ilustracion" />
            )}
            <h2 class="edad-lugar" tabindex="-1" data-titulo>{tarjeta.escena.edad} · {tarjeta.escena.lugar}</h2>
            <p class="texto-escena">{tarjeta.escena.texto}</p>
            <details class="detras" data-detras>
              <summary>
                ¿Qué hay detrás?
                <svg class="flecha" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
              </summary>
              <div class="reverso">
                <span class="chip">{nombreFamilia(tarjeta.termino.data.familia)}</span>
                <p>Detrás puede haber:</p>
                <p class="termino" tabindex="-1" data-nombre><NombreTermino datos={tarjeta.termino.data} /></p>
                <p>{primeraFrase(tarjeta.termino.data.que_es)}</p>
                <p>
                  <a href={`/glosario/${tarjeta.termino.id}/`}>Leer la ficha<span class="visualmente-oculto"> de <span lang={tituloEnIngles(tarjeta.termino.data) ? 'en' : undefined}>{tarjeta.termino.data.termino}</span></span></a>
                </p>
              </div>
            </details>
            <button type="button" class="marcar" aria-pressed="false" data-marcar hidden>
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
              Esto lo hemos visto
            </button>
          </li>
        ))}
      </ol>
      <div class="controles" data-controles hidden>
        <button type="button" class="boton secundario" data-anterior>Anterior</button>
        <button type="button" class="boton" data-siguiente>Siguiente</button>
      </div>
    </div>

    <section class="reconocido" aria-labelledby="reconocido" data-reconocido hidden>
      <h2 id="reconocido" tabindex="-1">Lo que habéis reconocido</h2>
      <p data-vacio>Todavía no habéis marcado ninguna escena. Si alguna os suena, pulsad «Esto lo hemos visto».</p>
      <ul class="relacionados">
        {terminos.map((t) => (
          <li data-termino={t.id} hidden><a href={`/glosario/${t.id}/`}><NombreTermino datos={t.data} /></a></li>
        ))}
      </ul>
      <p class="nota">Lo que marcáis se guarda solo en este navegador y no sale de aquí. Si compartís el móvil o el ordenador, borradlo al terminar.</p>
      <button type="button" class="borrar" data-borrar hidden>Borrar lo marcado</button>
    </section>
  </div>
</Base>

<script>
  import { guardar, leer, quitar } from '../lib/almacen';
  import { CLAVE_MARCADAS, leerMarcadas, terminosMarcados, textoProgreso } from '../lib/tarjetas';

  const visor = document.querySelector<HTMLElement>('[data-visor]');
  const reconocido = document.querySelector<HTMLElement>('[data-reconocido]');

  if (visor && reconocido) {
    const tarjetas = [...visor.querySelectorAll<HTMLElement>('[data-tarjeta]')];
    const ids = tarjetas.map((t) => t.dataset.id!);
    const terminoDe = new Map(tarjetas.map((t) => [t.dataset.id!, t.dataset.termino!]));
    const progreso = visor.querySelector<HTMLElement>('[data-progreso]')!;
    const controles = visor.querySelector<HTMLElement>('[data-controles]')!;
    const anterior = visor.querySelector<HTMLButtonElement>('[data-anterior]')!;
    const siguiente = visor.querySelector<HTMLButtonElement>('[data-siguiente]')!;
    const enLista = [...reconocido.querySelectorAll<HTMLElement>('li[data-termino]')];
    const vacio = reconocido.querySelector<HTMLElement>('[data-vacio]')!;
    const borrar = reconocido.querySelector<HTMLButtonElement>('[data-borrar]')!;
    const tituloReconocido = reconocido.querySelector<HTMLElement>('h2')!;

    // Solo se marcan las escenas; las escenas de elegir no tienen el botón.
    const marcables = ids.filter((_, i) => tarjetas[i].querySelector('[data-marcar]'));
    const marcadas = new Set(leerMarcadas(leer(CLAVE_MARCADAS), marcables));
    // Un enlace a /escenas/#escena-meltdown-2 abre esa tarjeta; recargar la página también.
    const escenaDelEnlace = () => ids.indexOf(decodeURIComponent(location.hash).replace(/^#escena-/, ''));
    const desdeEnlace = escenaDelEnlace();
    let actual = Math.max(desdeEnlace, 0);

    const pintar = () => {
      tarjetas.forEach((t, i) => {
        t.hidden = i !== actual;
        t.querySelector('[data-marcar]')?.setAttribute('aria-pressed', String(marcadas.has(ids[i])));
      });
      anterior.disabled = actual === 0;
      siguiente.disabled = actual === tarjetas.length - 1;
      progreso.textContent = textoProgreso(actual + 1, tarjetas.length, marcadas.size);
      const terminos = terminosMarcados(marcadas, terminoDe);
      enLista.forEach((li) => (li.hidden = !terminos.has(li.dataset.termino!)));
      vacio.hidden = terminos.size > 0;
      borrar.hidden = marcadas.size === 0;
    };

    const guardarMarcadas = () => {
      if (marcadas.size === 0) quitar(CLAVE_MARCADAS);
      else guardar(CLAVE_MARCADAS, JSON.stringify(ids.filter((id) => marcadas.has(id))));
    };

    // Al cambiar de tarjeta, el foco pasa a su título, para seguir leyendo desde ahí, y la página sube
    // si la tarjeta nueva empieza por encima de lo que se ve.
    const ir = (i: number) => {
      actual = i;
      pintar();
      history.replaceState(null, '', `#escena-${ids[actual]}`);
      if (visor.getBoundingClientRect().top < 0) visor.scrollIntoView();
      tarjetas[actual].querySelector<HTMLElement>('[data-titulo]')!.focus({ preventScroll: true });
    };

    tarjetas.forEach((tarjeta, i) => {
      const detras = tarjeta.querySelector<HTMLDetailsElement>('[data-detras]');
      // Al girar la tarjeta, el foco pasa al término.
      detras?.addEventListener('toggle', () => {
        if (detras.open) tarjeta.querySelector<HTMLElement>('[data-nombre]')!.focus();
      });
      const marcar = tarjeta.querySelector<HTMLButtonElement>('[data-marcar]');
      if (!marcar) return;
      marcar.hidden = false;
      marcar.addEventListener('click', () => {
        if (marcadas.has(ids[i])) marcadas.delete(ids[i]);
        else marcadas.add(ids[i]);
        guardarMarcadas();
        pintar();
      });
    });

    anterior.addEventListener('click', () => ir(actual - 1));
    siguiente.addEventListener('click', () => ir(actual + 1));
    // Si solo cambia el #escena-… de la dirección, la página no se recarga: se cambia de tarjeta aquí.
    addEventListener('hashchange', () => {
      const i = escenaDelEnlace();
      if (i >= 0 && i !== actual) ir(i);
    });
    borrar.addEventListener('click', () => {
      marcadas.clear();
      guardarMarcadas();
      pintar();
      // El botón desaparece: el foco va al título del apartado, que ya dice que no hay nada marcado.
      tituloReconocido.focus();
    });

    progreso.hidden = false;
    controles.hidden = false;
    reconocido.hidden = false;
    pintar();
    // El navegador baja hasta la tarjeta del enlace; se sube un poco para que se vea también el progreso.
    if (desdeEnlace >= 0) requestAnimationFrame(() => visor.scrollIntoView());
  }
</script>

<style>
  .escenas-pagina { display: flex; flex-direction: column; gap: 2.5rem; max-width: 44rem; padding-block: 1.5rem 0; }
  .escenas-pagina [hidden] { display: none; }
  .intro { display: flex; flex-direction: column; gap: 1rem; }
  .entradilla { font-size: 1.3125rem; font-weight: 300; color: var(--tinta-suave); }
  .aviso { background: var(--superficie); border-radius: 20px; padding: 1rem 1.25rem; }

  .visor { display: flex; flex-direction: column; gap: 1rem; scroll-margin-top: 1rem; }
  .progreso { font-weight: 500; color: var(--tinta-suave); }
  .tarjetas { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.5rem; }
  .tarjeta {
    max-width: none; /* global.css limita los li a 38em, que es para el texto */
    background: var(--superficie); border-radius: 28px; padding: clamp(1.25rem, 3vw, 2rem);
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem;
  }
  .ilustracion { width: 100%; height: auto; border-radius: 20px; background: #F4F3F9; }
  .edad-lugar { font-size: 1rem; font-weight: 500; color: var(--tinta-suave); letter-spacing: 0; }
  .texto-escena { font-size: 1.3125rem; }

  .detras { align-self: stretch; }
  .detras summary {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0.5rem 1.25rem;
    border: 2px solid var(--acento); border-radius: 999px; color: var(--acento);
    font-weight: 500; cursor: pointer; list-style: none;
  }
  .detras summary::-webkit-details-marker { display: none; }
  /* Abierta, la flecha mira hacia arriba: así no se confunde con «Esto lo hemos visto» marcado. */
  .flecha { transition: transform 0.2s ease-out; }
  .detras[open] .flecha { transform: rotate(180deg); }
  .reverso {
    margin-top: 0.75rem; padding: 1rem 1.25rem; border: 3px solid var(--familia); border-radius: 20px;
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.5rem;
  }
  /* El giro es un fundido corto. Con «reducir movimiento», la regla general de global.css lo quita. */
  .detras[open] .reverso { animation: fundido 0.2s ease-out; }
  @keyframes fundido { from { opacity: 0; } to { opacity: 1; } }
  .termino { font-size: 1.5rem; font-weight: 600; line-height: 1.25; }

  .marcar, .borrar {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0.5rem 1.25rem;
    border-radius: 999px; border: 2px solid var(--linea); background: transparent;
    color: var(--tinta); font: inherit; font-weight: 500; cursor: pointer;
  }
  .marcar svg { display: none; }
  .marcar[aria-pressed='true'] { border-color: var(--acento); background: var(--acento); color: var(--sobre-acento); }
  .marcar[aria-pressed='true'] svg { display: block; }
  .borrar { border-color: var(--tinta); }

  .controles { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem; }
  .controles .boton { border: 2px solid var(--acento); font: inherit; font-weight: 500; cursor: pointer; }
  .controles .secundario { background: transparent; color: var(--acento); }
  .controles .boton:disabled { opacity: 0.4; cursor: default; text-decoration: none; }

  .reconocido {
    background: var(--superficie); border-radius: 28px; padding: clamp(1.25rem, 3vw, 2rem);
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem;
  }
  .reconocido h2 { font-size: 1.5rem; }
  .nota { font-size: 0.9375rem; color: var(--tinta-suave); }

  @media (forced-colors: active) {
    /* Con colores forzados no se ven los fondos: el estado va en el color del sistema. */
    .marcar[aria-pressed='true'] { background: Highlight; color: HighlightText; }
  }
  /* En modo oscuro, algo menos de brillo para que la ilustración no deslumbre. */
  @media screen and (prefers-color-scheme: dark) {
    :global(:root:not([data-tema="claro"])) .ilustracion { filter: brightness(0.9); }
  }
  :global(:root[data-tema="oscuro"]) .ilustracion { filter: brightness(0.9); }
</style>
