---
import { getCollection } from 'astro:content';
import CabeceraGlosario from '../../components/CabeceraGlosario.astro';
import EntradaGlosario from '../../components/EntradaGlosario.astro';
import Base from '../../layouts/Base.astro';
import { FAMILIAS } from '../../lib/tokens';

const terminos = (await getCollection('glosario')).sort((a, b) =>
  a.data.termino.localeCompare(b.data.termino, 'es'),
);
const grupos = FAMILIAS.map((f) => ({
  ...f,
  terminos: terminos.filter((t) => t.data.familia === f.id),
})).filter((g) => g.terminos.length > 0);
---

<Base titulo="Glosario" descripcion="Las palabras que vais a oír al hablar de autismo, explicadas con calma y con lo que cambia en las niñas.">
  <div class="glosario">
    <CabeceraGlosario vista="familias" />
    {grupos.map((g) => (
      <section class={`f-${g.id}`} aria-labelledby={`familia-${g.id}`}>
        <h2 id={`familia-${g.id}`}><span class="chip">{g.nombre}</span></h2>
        <dl>{g.terminos.map((t) => <EntradaGlosario termino={t} />)}</dl>
      </section>
    ))}
  </div>
</Base>
