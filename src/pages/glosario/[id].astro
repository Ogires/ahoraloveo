---
import { getCollection, getEntries } from 'astro:content';
import TextoEnlazado from '../../components/TextoEnlazado.astro';
import Base from '../../layouts/Base.astro';
import { SITIO } from '../../config';
import { enlaceCorreccion } from '../../lib/correcciones';
import { enlazarEntidades, type Entidad } from '../../lib/enlazar';
import { NIVELES } from '../../lib/esquemas';
import { formatearFecha } from '../../lib/fecha';
import { exigirTodas } from '../../lib/referencias';
import { FAMILIAS } from '../../lib/tokens';

export async function getStaticPaths() {
  const terminos = await getCollection('glosario');
  return terminos.map((termino) => ({ params: { id: termino.id }, props: { termino } }));
}

const { termino } = Astro.props;
const d = termino.data;
const origen = `La ficha «${termino.id}»`;
const fuentes = exigirTodas(
  await getEntries(d.fuentes),
  d.fuentes.map((r) => `fuentes/${r.id}`),
  origen,
);
const relacionados = exigirTodas(
  await getEntries(d.relacionados),
  d.relacionados.map((r) => `glosario/${r.id}`),
  origen,
);
const entidades: Entidad[] = (await getCollection('entidades')).map((e) => ({
  nombres: [e.data.nombre, ...e.data.otros_nombres],
  web: e.data.web,
  idioma: e.data.idioma,
}));
// En el orden en que se leen los apartados: la primera mención de la ficha es la que enlaza.
const yaEnlazadas = new Set<Entidad>();
const enlazar = (t: string) => enlazarEntidades(t, entidades, yaEnlazadas);
const texto = {
  que_es: enlazar(d.que_es),
  como_se_ve: enlazar(d.como_se_ve),
  no_confundir_con: d.no_confundir_con ? enlazar(d.no_confundir_con) : null,
  en_ninas: enlazar(d.en_ninas),
  que_hacer: d.que_hacer ? enlazar(d.que_hacer) : null,
};
const familia = FAMILIAS.find((f) => f.id === d.familia)!;
const url = new URL(Astro.url.pathname, Astro.site).href;
---

<Base titulo={d.termino} descripcion={d.que_es}>
  <article class={`ficha f-${d.familia}`} data-pagefind-body>
    <p><a href="/glosario/">Glosario</a></p>
    <header>
      <span class="chip">{familia.nombre}</span>
      <h1>{d.termino}</h1>
      {d.alias.length > 0 && <p class="alias">También se dice: {d.alias.join(', ')}</p>}
    </header>

    <section aria-labelledby="que-es">
      <h2 id="que-es">Qué es</h2>
      <p><TextoEnlazado trozos={texto.que_es} /></p>
    </section>
    <section aria-labelledby="como-se-ve">
      <h2 id="como-se-ve">Cómo se ve</h2>
      <p><TextoEnlazado trozos={texto.como_se_ve} /></p>
    </section>
    {texto.no_confundir_con && (
      <section aria-labelledby="no-confundir">
        <h2 id="no-confundir">No confundir con</h2>
        <p><TextoEnlazado trozos={texto.no_confundir_con} /></p>
      </section>
    )}
    <section class="en-ninas" aria-labelledby="en-ninas">
      <h2 id="en-ninas">En niñas</h2>
      <p><TextoEnlazado trozos={texto.en_ninas} /></p>
    </section>
    {texto.que_hacer && (
      <section aria-labelledby="que-hacer">
        <h2 id="que-hacer">Qué podéis hacer</h2>
        <p><TextoEnlazado trozos={texto.que_hacer} /></p>
      </section>
    )}
    {relacionados.length > 0 && (
      <section aria-labelledby="relacionados">
        <h2 id="relacionados">Términos relacionados</h2>
        <ul class="relacionados">
          {relacionados.map((r) => <li><a href={`/glosario/${r.id}/`}>{r.data.termino}</a></li>)}
        </ul>
      </section>
    )}
    <section aria-labelledby="fuentes" data-pagefind-ignore>
      <h2 id="fuentes">Fuentes</h2>
      <ol class="fuentes">
        {fuentes.map((f) => (
          <li>
            {/* Un libro puede no tener ni URL ni DOI: entonces el título va sin enlace y se cita por su ISBN. */}
            {f.data.url || f.data.doi
              ? <a href={f.data.url ?? `https://doi.org/${f.data.doi}`} hreflang={f.data.idioma}>{f.data.titulo}</a>
              : <cite>{f.data.titulo}</cite>}
            {`. ${f.data.autoria}, ${f.data.editorial ? `${f.data.editorial}, ` : ''}${f.data.anio}`}
            {f.data.isbn && `. ISBN ${f.data.isbn}`}{'. '}
            <span class="nivel">
              {NIVELES[f.data.nivel]}
              {f.data.estudio && ` con ${f.data.estudio.muestra} participantes`}
              {f.data.estudio && f.data.estudio.porcentaje_ninas !== null &&
                `, ${f.data.estudio.porcentaje_ninas} % niñas o mujeres`}
            </span>
          </li>
        ))}
      </ol>
    </section>
    <footer class="meta">
      <p>Revisado el {formatearFecha(d.revisado)}.</p>
      <p><a href={enlaceCorreccion({ correo: SITIO.correo, pagina: d.termino, url })}>¿Algo está mal o desactualizado? Avisadnos</a></p>
    </footer>
  </article>
</Base>

<style>
  .ficha { display: flex; flex-direction: column; gap: 2.5rem; max-width: 44rem; padding-block: 1.5rem 0; }
  header { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  section { display: flex; flex-direction: column; gap: 0.75rem; }
  h2 { font-size: 1.5rem; }
  .alias { color: var(--tinta-suave); }
  .en-ninas { background: var(--superficie); border: 3px solid var(--familia); border-radius: 28px; padding: clamp(1.25rem, 3vw, 2rem); }
  .relacionados { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .fuentes { display: flex; flex-direction: column; gap: 0.75rem; padding-left: 1.5rem; }
  .nivel { font-weight: 500; }
  .meta { display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.9375rem; color: var(--tinta-suave); }
</style>
