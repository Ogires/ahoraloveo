---
import { Image } from 'astro:assets';
import { getCollection, getEntries } from 'astro:content';
import EscenaElegir from '../../components/EscenaElegir.astro';
import ListaFuentes from '../../components/ListaFuentes.astro';
import NombreTermino from '../../components/NombreTermino.astro';
import PieRevision from '../../components/PieRevision.astro';
import TextoEnlazado from '../../components/TextoEnlazado.astro';
import Base from '../../layouts/Base.astro';
import { comprobarEscenarios, escenariosDe } from '../../lib/elegir';
import { enlazarEntidades } from '../../lib/enlazar';
import { cargarEntidades } from '../../lib/entidades';
import { PESOS } from '../../lib/esquemas';
import { mitosDe } from '../../lib/mitos';
import { programasDe } from '../../lib/programas';
import { exigirTodas } from '../../lib/referencias';
import { otroNombre, tituloEnIngles } from '../../lib/terminos';
import { FAMILIAS } from '../../lib/tokens';

export async function getStaticPaths() {
  const terminos = await getCollection('glosario');
  // Una vez por compilación: cada escena de elegir cita solo fuentes de sus fichas, y va en una que tiene
  // «No confundir con».
  comprobarEscenarios(await getCollection('escenarios'), terminos);
  return terminos.map((termino) => ({ params: { id: termino.id }, props: { termino } }));
}

const { termino } = Astro.props;
const d = termino.data;
const origen = `La ficha «${termino.id}»`;
const fuentes = exigirTodas(
  await getEntries(d.fuentes),
  d.fuentes.map((r) => `fuentes/${r.id}`),
  origen,
);
const relacionados = exigirTodas(
  await getEntries(d.relacionados),
  d.relacionados.map((r) => `glosario/${r.id}`),
  origen,
);
const mitos = mitosDe(termino.id, await getCollection('mitos'));
// Los programas estudiados que nombran esta ficha, agrupados por la edad en que empiezan.
const programas = programasDe(termino.id, await getCollection('programas'));
const escenarios = escenariosDe(termino.id, await getCollection('escenarios'));
const entidades = await cargarEntidades();
// Cada apartado enlaza la primera vez que nombra cada entidad, para que se pueda leer suelto.
const enlazar = (t: string) => enlazarEntidades(t, entidades);
const texto = {
  que_es: enlazar(d.que_es),
  como_se_ve: enlazar(d.como_se_ve),
  no_confundir_con: d.no_confundir_con ? enlazar(d.no_confundir_con) : null,
  en_ninas: enlazar(d.en_ninas),
  que_hacer: d.que_hacer ? enlazar(d.que_hacer) : null,
};
const familia = FAMILIAS.find((f) => f.id === d.familia)!;
// Los otros nombres en español y, detrás, los ingleses, con lang="en" para el lector de pantalla.
const otrosNombres = [
  ...d.alias.map((texto) => ({ texto, ingles: false })),
  ...d.alias_en_ingles.map((texto) => ({ texto, ingles: true })),
];
---

<Base titulo={`${d.termino} (${otroNombre(d).texto})`} descripcion={d.que_es}>
  <article class={`ficha f-${d.familia}`} data-pagefind-body>
    {/* La navegación no se indexa: buscar «crisis» no debe traer cada ficha que solo la enlaza. */}
    <p data-pagefind-ignore><a href="/glosario/">Glosario</a></p>
    <header>
      <span class="chip">{familia.nombre}</span>
      {/* El título es el nombre más usado en español al hablar de autismo, a veces inglés. Lo inglés
          va con lang="en" para que el lector de pantalla lo pronuncie bien. */}
      {tituloEnIngles(d) ? (
        <>
          <h1 lang="en">{d.termino}</h1>
          <p class="otro-nombre">En español: {d.en_espanol.join(', ')}</p>
        </>
      ) : (
        <>
          <h1>{d.termino}</h1>
          <p class="otro-nombre">En inglés: <span lang="en">{d.en_ingles}</span></p>
        </>
      )}
      {otrosNombres.length > 0 && (
        <p class="alias">También se dice: {otrosNombres.map((n, i) => (
          <>{i > 0 && ', '}{n.ingles ? <span lang="en">{n.texto}</span> : n.texto}</>
        ))}</p>
      )}
    </header>

    <section aria-labelledby="que-es">
      <h2 id="que-es">Qué es</h2>
      <p><TextoEnlazado trozos={texto.que_es} /></p>
    </section>
    <section aria-labelledby="como-se-ve">
      <h2 id="como-se-ve">Cómo se ve</h2>
      <p><TextoEnlazado trozos={texto.como_se_ve} /></p>
    </section>
    {d.escenas.length > 0 && (
      <section aria-labelledby="dia-a-dia">
        <h2 id="dia-a-dia">En el día a día</h2>
        <ul class="escenas">
          {d.escenas.map((e) => (
            <li class="escena">
              {e.imagen && (
                // El alt va vacío a propósito: la imagen no cuenta nada que no diga el texto (guía de escenas).
                <Image src={e.imagen} alt="" widths={[400, 800, 1200]} sizes="(min-width: 48rem) 42rem, 100vw" class="ilustracion" />
              )}
              <p class="edad-lugar">{e.edad} · {e.lugar}</p>
              <p>{e.texto}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
    {texto.no_confundir_con && (
      <section class="no-confundir" aria-labelledby="no-confundir">
        <h2 id="no-confundir">No confundir con</h2>
        <p><TextoEnlazado trozos={texto.no_confundir_con} /></p>
        {escenarios.map((e) => <EscenaElegir escenario={e} nivel={3} />)}
      </section>
    )}
    <section class="en-ninas" aria-labelledby="en-ninas">
      <h2 id="en-ninas">En niñas</h2>
      <p><TextoEnlazado trozos={texto.en_ninas} /></p>
    </section>
    {texto.que_hacer && (
      <section aria-labelledby="que-hacer">
        <h2 id="que-hacer">Qué podéis hacer</h2>
        <p><TextoEnlazado trozos={texto.que_hacer} /></p>
      </section>
    )}
    {programas.length > 0 && (
      <section aria-labelledby="programas">
        <h2 id="programas">Programas estudiados</h2>
        {programas.map((g) => (
          <>
            <h3 class="tramo">{g.titulo}</h3>
            <ul class="programas">
              {g.programas.map((p) => (
                <li>
                  <a href={`/programas/${p.id}/`}>{p.data.nombre}</a> ({p.data.edades.charAt(0).toLowerCase() + p.data.edades.slice(1)}): {p.data.para_que.charAt(0).toLowerCase() + p.data.para_que.slice(1)} <span class="peso">{PESOS[p.data.peso]}.</span>
                </li>
              ))}
            </ul>
          </>
        ))}
        <p class="aviso-programas">Que existan no quiere decir que haya que hacerlos. Si os interesa alguno, preguntad por él a quien la atiende.</p>
      </section>
    )}
    {mitos.length > 0 && (
      <section aria-labelledby="mitos" data-pagefind-ignore>
        <h2 id="mitos">Mitos sobre esto</h2>
        <ul class="relacionados">
          {mitos.map((m) => <li><a href={`/mitos/${m.id}/`}>«{m.data.mito}»</a></li>)}
        </ul>
      </section>
    )}
    {relacionados.length > 0 && (
      <section aria-labelledby="relacionados" data-pagefind-ignore>
        <h2 id="relacionados">Términos relacionados</h2>
        <ul class="relacionados">
          {relacionados.map((r) => <li><a href={`/glosario/${r.id}/`}><NombreTermino datos={r.data} /></a></li>)}
        </ul>
      </section>
    )}
    <section aria-labelledby="fuentes" data-pagefind-ignore>
      <h2 id="fuentes">Fuentes</h2>
      <ListaFuentes fuentes={fuentes} />
    </section>
    <PieRevision revisado={d.revisado} pagina={d.termino} />
  </article>
</Base>

<style>
  .otro-nombre { font-size: 1.3125rem; }
  .alias { color: var(--tinta-suave); }
  .escenas { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .escena { background: var(--superficie); border-radius: 20px; padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: 0.375rem; }
  .no-confundir :global(.elegir) { background: var(--superficie); border-radius: 20px; padding: 1rem 1.25rem; margin-top: 0.5rem; }
  .edad-lugar { font-size: 0.9375rem; font-weight: 500; color: var(--tinta-suave); }
  .programas { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.5rem; }
  .peso, .aviso-programas { color: var(--tinta-suave); }
  .tramo { font-size: 1.125rem; }
  .ilustracion { width: 100%; height: auto; border-radius: 14px; background: #F4F3F9; }
  /* En modo oscuro, algo menos de brillo para que no deslumbre. */
  @media screen and (prefers-color-scheme: dark) {
    :global(:root:not([data-tema="claro"])) .ilustracion { filter: brightness(0.9); }
  }
  :global(:root[data-tema="oscuro"]) .ilustracion { filter: brightness(0.9); }
</style>
