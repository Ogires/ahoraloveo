---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { ordenarMitos } from '../../lib/mitos';

const mitos = ordenarMitos(await getCollection('mitos'));
---

<Base titulo="Mitos sobre el autismo" descripcion="Lo que se suele oír sobre el autismo, y lo que de verdad sabemos. Cada mito, con sus fuentes.">
  <div class="texto">
    <h1>Mitos sobre el autismo</h1>
    <p class="entradilla">Lo que se suele oír sobre el autismo, y lo que de verdad sabemos. Cada mito, con sus fuentes.</p>
    <ul class="mitos">
      {mitos.map((m) => (
        <li class="mito">
          <a href={`/mitos/${m.id}/`}>«{m.data.mito}»</a>
          <p class="dato">{m.data.dato}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .entradilla { font-size: 1.3125rem; font-weight: 300; color: var(--tinta-suave); }
  .mitos { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .mito { background: var(--superficie); border-radius: 20px; padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: 0.375rem; }
  .mito a { font-size: 1.1875rem; font-weight: 500; }
  .dato { color: var(--tinta-suave); }
</style>
