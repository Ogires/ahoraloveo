---
import '@fontsource-variable/lexend';
import '../styles/global.css';
import Rueda from '../components/Rueda.astro';
import SelectorTema from '../components/SelectorTema.astro';
import { SITIO } from '../config';
import { metaRobots } from '../lib/seo';
import { mediaBarra } from '../lib/tema';
import { CLARO, OSCURO } from '../lib/tokens';

interface Props {
  titulo: string;
  descripcion: string;
  indexable?: boolean;
  canonica?: string | null;
}

const { titulo, descripcion, indexable = true, canonica: canonicaProp } = Astro.props;
const tituloCompleto = titulo === SITIO.nombre ? titulo : `${titulo} | ${SITIO.nombre}`;
const canonica = canonicaProp === null ? null : new URL(canonicaProp ?? Astro.url.pathname, Astro.site).href;
const robots = metaRobots(SITIO.publicada, indexable);
// La tarjeta que muestran LinkedIn, WhatsApp y otras redes al compartir un enlace.
// La imagen es la misma en todas las páginas; el texto alternativo dice lo que pone en ella.
const imagenCompartir = new URL('/compartir.png', Astro.site).href;
const altCompartir = `${SITIO.nombre}. ${SITIO.tema}. ${SITIO.lema}.`;
const ruta = Astro.url.pathname;
const enlaces = [
  { href: '/glosario/', texto: 'Glosario' },
  { href: '/diagnostico/', texto: 'Diagnóstico' },
  { href: '/mitos/', texto: 'Mitos' },
  { href: '/programas/', texto: 'Programas' },
  { href: '/a-quien-acudir/', texto: 'A quién acudir' },
  { href: '/buscar/', texto: 'Buscar' },
  { href: '/sobre/', texto: 'Sobre esta web' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {canonica && <link rel="canonical" href={canonica} />}
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    {canonica && <meta property="og:url" content={canonica} />}
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={altCompartir} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={CLARO.fondo} media={mediaBarra('claro', null)} data-tema="claro" />
    <meta name="theme-color" content={OSCURO.fondo} media={mediaBarra('oscuro', null)} data-tema="oscuro" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script is:inline src="/tema.js"></script>
    <link rel="stylesheet" href="/tokens.css" />
    <slot name="cabeza" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera contenedor">
      <a class="marca" href="/">
        <Rueda tamano={34} />
        <span>{SITIO.nombre}</span>
      </a>
      <nav aria-label="Principal">
        <ul>
          {enlaces.map((e) => (
            <li>
              <a href={e.href} aria-current={ruta.startsWith(e.href) ? 'page' : undefined}>{e.texto}</a>
            </li>
          ))}
        </ul>
      </nav>
      <SelectorTema />
    </header>
    <main id="contenido" class="contenedor" tabindex="-1">
      <slot />
    </main>
    <footer class="pie contenedor">
      <p>Información divulgativa. No sustituye un diagnóstico ni el consejo profesional.</p>
      <p>
        Textos con licencia <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.es" hreflang="es">CC BY-SA 4.0</a>.{' '}
        <a href="/aviso-legal/">Aviso legal y privacidad</a>
      </p>
    </footer>
    {SITIO.analytics && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: SITIO.analytics })}
      ></script>
    )}
  </body>
</html>
