---
// Cabecera de las dos vistas del índice del glosario, con el selector para cambiar de una a otra.
// Son dos páginas, no un botón: así funcionan sin JavaScript y cada vista tiene su enlace.
import type { Familia } from '../lib/tokens';

export interface SaltoGlosario {
  href: string;
  texto: string;
  familia?: Familia;
}

interface Props {
  vista: 'familias' | 'a-z';
  etiquetaSaltos: string;
  saltos: SaltoGlosario[];
}

const { vista, etiquetaSaltos, saltos } = Astro.props;
const vistas = [
  { id: 'familias', href: '/glosario/', texto: 'Por familias' },
  { id: 'a-z', href: '/glosario/a-z/', texto: 'De la A a la Z' },
];
---

<header class="cabecera-glosario">
  <h1>Glosario</h1>
  <p>Las palabras que vais a oír al hablar de autismo. Cada término dice de dónde sale la información y cuándo se revisó.</p>
  <p>
    Si preferís empezar por situaciones del día a día, mirad las <a href="/escenas/">escenas «¿Lo habéis visto?»</a>.
    Si buscáis una palabra concreta, usad <a href="/buscar/">el buscador</a>.
  </p>
  <nav class="vistas" aria-label="Orden del glosario">
    <ul>
      {vistas.map((v) => (
        <li><a href={v.href} aria-current={v.id === vista ? 'page' : undefined}>{v.texto}</a></li>
      ))}
    </ul>
  </nav>
  {saltos.length > 0 && (
    <nav class={`saltos${vista === 'a-z' ? ' saltos-letras' : ''}`} aria-label={etiquetaSaltos}>
      <ul>
        {saltos.map((s) => (
          <li>
            <a href={s.href} class={s.familia ? `f-${s.familia}` : undefined}>{s.texto}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</header>

<style>
  .cabecera-glosario { display: flex; flex-direction: column; gap: 0.75rem; }
  .vistas ul, .saltos ul { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0.5rem 0 0; }
  .vistas a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0.4rem 1rem;
    border: 2px solid var(--acento); border-radius: 999px;
    text-decoration: none; font-weight: 500;
  }
  .vistas a[aria-current='page'] { background: var(--acento); color: var(--sobre-acento); }
  .saltos a {
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0.4rem 1rem;
    border-radius: 999px; font-size: 0.9375rem; font-weight: 500; text-decoration: none;
    background: var(--familia, var(--superficie)); color: var(--sobre-familia, var(--tinta));
  }
  .saltos-letras a {
    min-width: 44px; padding: 0.4rem 0.75rem; border: 2px solid var(--linea); font-weight: 600;
  }
  .saltos a:hover { text-decoration: underline; }
  .saltos-letras a:hover { border-color: var(--acento); color: var(--acento); }
  @media (forced-colors: active) {
    .vistas a[aria-current='page'] { background: Highlight; color: HighlightText; }
    .saltos a { border: 2px solid LinkText; }
  }
</style>
